---
// Stands in for an Astro component. server.js serves this markup the way Astro's
// dev server does: each element carries this file's absolute path and the
// line:column of its opening tag.
//
// The label inside the button has no attributes of its own, like markup an Astro
// expression renders, so picking it resolves through the button.
---
<section class="hero">
  <h1>Gui Astro-like fixture</h1>
  <div class="actions">
    <button type="button" class="cta"><span class="label">Get started</span></button>
  </div>
</section>
