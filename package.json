{
  "name": "gui",
  "productName": "Gui",
  "version": "0.1.0-alpha.18",
  "description": "Design real interfaces with your own AI agents",
  "author": "Bridger Tower <bridgertower@gmail.com>",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "sh scripts/build-native.sh && electron-vite dev -w",
    "build": "sh scripts/build-native.sh && electron-vite build",
    "build:native": "sh scripts/build-native.sh",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true; git config core.hooksPath .githooks 2>/dev/null || true",
    "test:e2e": "bun run build && playwright test",
    "test:fast": "bun test tests && bun tests/fast/chat-store.ts && bun scripts/test-chat-transport.ts",
    "test:accounts": "bun test --cwd accounts",
    "benchmark:history": "bun scripts/benchmark-history.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check": "bun run typecheck && bun run lint && bun run check:architecture && bun run test:fast && bun run --cwd accounts typecheck && bun run test:accounts",
    "dist": "bun run build && bunx --bun electron-builder --mac",
    "install-app": "sh scripts/install-app.sh",
    "release": "sh scripts/release.sh"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "node-pty"
  ],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.101.1",
    "@agentclientprotocol/codex-acp": "^2.6.0",
    "@agentclientprotocol/sdk": "^1.7.0",
    "@bex-co/muse-code-acp": "0.11.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "amp-acp": "0.12.0",
    "electron-updater": "^6.8.9",
    "ghostty-web": "0.4.0",
    "node-pty": "^1.1.0",
    "pi-acp": "0.0.34",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.4.4",
    "decode-named-character-reference": "^1.3.0",
    "electron": "^44.10.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "7",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
