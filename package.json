{
  "name": "gui",
  "productName": "Gui",
  "version": "0.1.0",
  "description": "Design real interfaces with your own AI agents",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac",
    "install-app": "sh scripts/install-app.sh"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "node-pty"
  ],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.85.1",
    "@agentclientprotocol/codex-acp": "^2.1.1",
    "@agentclientprotocol/sdk": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "node-pty": "^1.1.0",
    "pi-acp": "0.0.34",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "7",
    "zustand": "^5.0.15"
  }
}
