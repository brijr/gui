{
  "name": "gui-www",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "test": "astro build && playwright test",
    "migrate": "wrangler d1 migrations apply gui-www --remote",
    "migrate:local": "wrangler d1 migrations apply gui-www --local",
    "stats": "wrangler d1 execute gui-www --remote --command \"$(grep -v ^-- scripts/stats.sql)\""
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.147.0"
  }
}
