{
  "name": "usegui",
  "compatibility_date": "2026-10-01",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker runs first so it can send www to the apex domain.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Gui's builds and update feed, published by scripts/release.sh.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "gui-releases" }],
  // The Windows and Linux waitlist, and a row for each download.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gui-www",
      "database_id": "d7043f1c-53b5-44e5-a6c0-7cb1b3355e83",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "usegui.com", "custom_domain": true },
    { "pattern": "www.usegui.com", "custom_domain": true }
  ]
}
