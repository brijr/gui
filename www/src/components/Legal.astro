---
import Base from '../layouts/Base.astro'

interface Props {
  title: string
  description: string
  path: string
  updated: string
}

const { title, description, path, updated } = Astro.props
---

<Base title={`${title} — Gui`} description={description} path={path}>
  <a class="mark" href="/" aria-label="Gui home page">
    <img src="/mark-animated.svg" alt="" width="40" height="40" />
  </a>
  <h1>{title}</h1>
  <p class="updated">Updated {updated}</p>
  <div class="legal"><slot /></div>
  <footer><a href="/">Gui</a> · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></footer>
</Base>

<style>
  .mark {
    display: block;
    width: fit-content;
    margin-bottom: var(--s-5);
  }
  h1 {
    font-size: 2.5rem;
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 250;
    margin-bottom: var(--s-2);
  }
  .updated {
    color: var(--muted);
    margin-bottom: var(--s-5);
  }
  .legal {
    max-width: 40rem;
  }
  .legal :global(h2) {
    font-size: 1.25rem;
    font-weight: 400;
    margin: var(--s-5) 0 var(--s-3);
  }
  .legal :global(p),
  .legal :global(ul) {
    margin-bottom: var(--s-3);
  }
  .legal :global(ul) {
    padding-left: var(--s-4);
  }
  .legal :global(li) {
    margin-bottom: var(--s-2);
  }
  footer {
    margin-top: var(--s-6);
    color: var(--muted);
  }
</style>
