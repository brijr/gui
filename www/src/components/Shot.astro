---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// A screenshot of Gui, with a dark-mode version for visitors in dark mode.
interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  alt: string
  widths: number[]
  sizes: string
  eager?: boolean
  /** Draw the window's edge: a 1px line that follows its rounded corners. */
  framed?: boolean
}

const { light, dark, alt, widths, sizes, eager = false, framed = false } = Astro.props

// The window's corner radius in the 2x screenshots, as a percentage of the image so it scales.
const CORNER = 35
const radius = framed
  ? `${((CORNER / light.width) * 100).toFixed(3)}% / ${((CORNER / light.height) * 100).toFixed(3)}%`
  : undefined

async function srcset(src: ImageMetadata, format: 'avif' | 'webp') {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format })))
  return images.map((image, i) => `${image.src} ${widths[i]}w`).join(', ')
}

const formats = ['avif', 'webp'] as const
const sources = await Promise.all(
  formats.flatMap((format) => [
    srcset(dark, format).then((set) => ({ set, format, media: '(prefers-color-scheme: dark)' })),
    srcset(light, format).then((set) => ({ set, format, media: undefined })),
  ]),
)
const fallback = await getImage({
  src: light,
  width: widths[widths.length - 2] ?? widths[0],
  format: 'png',
})
---

<picture>
  {sources.map(({ set, format, media }) => <source type={`image/${format}`} srcset={set} sizes={sizes} media={media} />)}
  <img
    src={fallback.src}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class:list={{ framed }}
    style={radius && `border-radius: ${radius}`}
  />
</picture>

<style>
  .framed {
    border: 1px solid var(--rule);
  }
</style>
