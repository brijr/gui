---
import '../styles/gui.css'
import { svg } from './demo/icons'

// One step of "How it works", drawn with Gui's own interface rather than a screenshot: the same
// session as the "Try it now" demo ("real app" made semi-bold). Each stage is laid out at
// 532 × 399 and scales with its card (--u is one of those pixels), as a picture would, but stays
// sharp and follows the visitor's appearance.
interface Props {
  kind: 'select' | 'describe' | 'watch' | 'compare' | 'narrate' | 'check'
  /** What the stage shows, for screen readers */
  label: string
}

const { kind, label } = Astro.props
const prompt = 'Make this semi-bold.'

// The chat's header, and the row under the composer
const head = (live: boolean) =>
  `<header class="head"><span class="dot${live ? ' is-live' : ''}"></span><b>Claude Code</b>${svg('chevronDown', 12)}<span class="grow"></span>${svg('newChat')}${svg('panelRight')}${svg('more')}</header>`
const stopButton = '<span class="send is-stop">' + svg('stop') + '</span>'
const foot = (running: boolean) =>
  `<div class="foot"><span class="tool">${svg('paperclip')}</span><span class="tool is-auto">${svg('shieldCheck')}</span><span class="grow"></span><span class="model">Sonnet 5.5 ${svg('chevronDown', 12)}</span><span class="send${running ? ' is-off' : ''}">${svg('arrowUp')}</span>${running ? stopButton : ''}</div>`
// What the app calls a picked element: its kind, then its source file and line
const picked = { name: 'Text', text: 'real app', where: 'index.astro:24' }
---

<div class="stage gui" data-kind={kind} role="img" aria-label={label}>
  <div class="ui" aria-hidden="true">
    {
      kind === 'select' && (
        <div class="page-bit">
          <p class="bit-lede">
            Design on your{' '}
            <span class="target">
              real app
              <span class="outline">
                <span class="label">
                  span <span>130 × 49</span>
                </span>
              </span>
            </span>
            , not on a mockup.
          </p>
          <p class="bit-sub">Select an element, then tell your AI agent what to change.</p>
          <svg class="arrow" viewBox="0 0 24 24">
            <path d="M5 2.5v16.2l4.2-4.1 2.7 6.3 2.9-1.2-2.7-6.2h5.9z" />
          </svg>
        </div>
      )
    }

    {
      kind === 'describe' && (
        <div class="panel is-alone">
          <div class="context">
            <span class="thumb"><i>real app</i></span>
            <span class="context-text">
              <span>
                <b>{picked.name}</b> <span class="path">{picked.text}</span>
              </span>
              <code class="path">{picked.where}</code>
            </span>
            <span class="x" set:html={svg('x', 12)} />
          </div>
          <div class="composer is-focused">
            <p>
              {prompt}
              <span class="caret" />
            </p>
            <Fragment set:html={foot(false)} />
          </div>
        </div>
      )
    }

    {
      kind === 'watch' && (
        <div class="panel">
          <Fragment set:html={head(true)} />
          <div class="transcript">
            <div class="you">
              <span class="chip">
                <Fragment set:html={svg('pointer', 11)} />
                <b>{picked.name}</b> <code>{picked.where}</code>
              </span>
              <p>{prompt}</p>
            </div>
            <div class="step is-done">
              <span class="step-icon" set:html={svg('check', 12)} />
              Read <code>src/pages/index.astro</code>
            </div>
            <div class="step is-done">
              <span class="step-icon" set:html={svg('check', 12)} />
              Edit <code>src/pages/index.astro</code>
              <span class="diffstat">
                <span class="plus">+3</span> <span class="minus">−1</span>
              </span>
            </div>
            <div class="step">
              <span class="step-icon">
                <span class="spinner" />
              </span>
              Working <span class="timer" data-timer>4s</span>
            </div>
          </div>
          <div class="composer">
            <p class="placeholder">Queue a message…</p>
            <Fragment set:html={foot(true)} />
          </div>
        </div>
      )
    }

    {
      kind === 'compare' && (
        <div class="panel">
          <Fragment set:html={head(true)} />
          <div class="transcript">
            <p class="reply">
              I changed the weight of “real app” from 250 to 450. The rest of the headline stays light.
            </p>
            <div class="card">
              <div class="compare">
                <figure>
                  Before
                  <div class="shot">real app</div>
                </figure>
                <figure>
                  After
                  <div class="shot">
                    <b class="bold">real app</b>
                  </div>
                </figure>
              </div>
              <div class="card-foot">
                <Fragment set:html={svg('chevronRight', 12)} />1 file changed
                <span class="diffstat">
                  <span class="plus">+3</span> <span class="minus">−1</span>
                </span>
                <span class="buttons">
                  <span class="button is-quiet">
                    <Fragment set:html={svg('reply')} />
                    Follow up
                  </span>
                  <span class="button">
                    <Fragment set:html={svg('undo')} />
                    Undo
                  </span>
                </span>
              </div>
            </div>
          </div>
        </div>
      )
    }

    {
      kind === 'narrate' && (
        <div class="panel is-alone">
          <div class="context">
            <span class="clip">
              <span class="clip-card" />
              <span class="clip-play" set:html={svg('play', 9)} />
            </span>
            <span class="context-text">
              <span>Recording 1</span>
              <span class="path">
                <span class="nums">14.2s</span> · Narrated
              </span>
            </span>
            <span class="x" set:html={svg('x', 12)} />
          </div>
          <div class="composer is-focused">
            <p>
              This card slides in too fast. And here, at the end, the shadow comes in after the card stops.
              <span class="caret" />
            </p>
            <Fragment set:html={foot(false)} />
          </div>
        </div>
      )
    }

    {
      kind === 'check' && (
        <div class="panel">
          <Fragment set:html={head(true)} />
          <div class="transcript">
            <div class="you">
              <span class="chip">
                <Fragment set:html={svg('pointer', 11)} />
                <b>Plans</b> <code>Plans.tsx:12</code>
              </span>
              <p>Put the three plans in one row.</p>
            </div>
            <div class="step is-done">
              <span class="step-icon" set:html={svg('check', 12)} />
              Edit <code>src/components/Plans.tsx</code>
              <span class="diffstat">
                <span class="plus">+6</span> <span class="minus">−2</span>
              </span>
            </div>
            <div class="step is-done">
              <span class="step-icon" set:html={svg('check', 12)} />
              Screenshot at 1440 × 900
            </div>
            <div class="step is-done">
              <span class="step-icon" set:html={svg('check', 12)} />
              Screenshot at 390 × 844
            </div>
            <div class="step is-done">
              <span class="step-icon" set:html={svg('check', 12)} />
              Edit <code>src/components/Plans.tsx</code>
              <span class="diffstat">
                <span class="plus">+2</span> <span class="minus">−0</span>
              </span>
            </div>
            <div class="card">
              <p class="reply">The plans are in one row. They did not fit on a phone, so they stack there.</p>
              <div class="sizes">
                <figure>
                  <span class="nums">1440</span> wide
                  <div class="mini mini-row">
                    <i />
                    <i />
                    <i />
                  </div>
                </figure>
                <figure>
                  <span class="nums">390</span> wide
                  <div class="mini mini-stack">
                    <i />
                    <i />
                    <i />
                  </div>
                </figure>
              </div>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<script>
  // The "Working" timer counts up while it is on screen, as it does in the app.
  for (const timer of document.querySelectorAll<HTMLElement>('[data-timer]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue
    let seconds = 4
    let tick = 0
    new IntersectionObserver(([entry]) => {
      clearInterval(tick)
      if (!entry.isIntersecting) return
      tick = window.setInterval(() => {
        seconds = seconds >= 59 ? 4 : seconds + 1
        timer.textContent = `${seconds}s`
      }, 1000)
    }).observe(timer)
  }
</script>

<style>
  .stage {
    user-select: none;
    pointer-events: none;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid var(--rule);
    background: var(--canvas);
  }
  .ui {
    /* One pixel of the 532-wide layout */
    --u: calc(100cqi / 532);
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--c-fg);
    font-family: var(--font-ui);
    font-size: calc(var(--u) * 13);
    line-height: calc(18 / 13);
    font-weight: 400;
    letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.885em;
  }
  b {
    font-weight: 600;
  }

  /* 1. A piece of the site, with the words selected */
  [data-kind='select'] {
    background: var(--bg);
  }
  .page-bit {
    position: relative;
    width: calc(var(--u) * 430);
    font-family: inherit;
  }
  .bit-lede {
    color: var(--fg);
    font-family: 'Inter Tight Variable', 'Inter Tight Fallback Light', 'Inter Tight Fallback', sans-serif;
    font-size: calc(var(--u) * 40);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 250;
  }
  .bit-sub {
    margin-top: calc(var(--u) * 14);
    color: var(--muted);
    font-family: 'Inter Tight Variable', 'Inter Tight Fallback Light', 'Inter Tight Fallback', sans-serif;
    font-size: calc(var(--u) * 16);
    line-height: 1.45;
    font-weight: 300;
  }
  .target {
    position: relative;
    white-space: nowrap;
  }
  .outline {
    position: absolute;
    inset: 0.04em -0.06em -0.02em;
    border: calc(var(--u) * 2) solid var(--accent);
    border-radius: calc(var(--u) * 4);
  }
  .label {
    position: absolute;
    left: calc(var(--u) * -2);
    bottom: calc(100% + var(--u) * 4);
    display: flex;
    gap: calc(var(--u) * 6);
    align-items: center;
    height: calc(var(--u) * 20);
    padding: 0 calc(var(--u) * 6);
    border-radius: calc(var(--u) * 4);
    background: var(--accent);
    color: var(--accent-fg);
    font: 500 calc(var(--u) * 11) / 1 var(--font-ui);
    letter-spacing: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .label span {
    font-weight: 400;
  }
  .arrow {
    position: absolute;
    left: calc(var(--u) * 372);
    top: calc(var(--u) * 30);
    width: calc(var(--u) * 22);
    fill: #111;
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.3));
  }

  /* 2–4. The chat panel, as it floats over the preview */
  .panel {
    display: flex;
    flex-direction: column;
    width: calc(var(--u) * 372);
    height: calc(var(--u) * 351);
    overflow: hidden;
    border-radius: calc(var(--u) * 12);
    background: var(--raised);
    box-shadow: var(--elevation-panel);
  }
  .panel :global(.head) {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.46em;
    height: 2.77em;
    padding: 0 0.6em 0 0.92em;
    border-bottom: 1px solid var(--line);
    color: var(--c-muted);
  }
  .panel :global(.head b) {
    color: var(--c-fg);
    font-weight: 500;
  }
  .panel :global(.dot) {
    width: 0.46em;
    height: 0.46em;
    border-radius: 50%;
    background: var(--subtle);
  }
  .panel :global(.dot.is-live) {
    background: var(--success);
  }
  .panel :global(.grow) {
    flex: 1;
  }
  .panel :global(svg) {
    width: 1.08em;
    height: 1.08em;
    flex: none;
  }
  /* With no conversation yet, the floating chat is only its message box */
  .panel.is-alone {
    height: auto;
    gap: 0.62em;
    padding: 0.62em;
  }
  .is-alone .context,
  .is-alone .composer {
    margin: 0;
  }

  .context {
    display: flex;
    align-items: center;
    gap: 0.62em;
    margin: 0 0.62em 0.46em;
    padding: 0.46em 0.62em 0.46em 0.46em;
    border-radius: 0.62em;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .thumb {
    flex: none;
    display: flex;
    align-items: center;
    width: 3.4em;
    height: 2.6em;
    padding-left: 0.3em;
    overflow: hidden;
    border-radius: 0.3em;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--fg);
    font-family: 'Inter Tight Variable', 'Inter Tight Fallback', sans-serif;
    font-size: 1.15em;
    font-weight: 300;
    white-space: nowrap;
  }
  .thumb i {
    font-style: normal;
    border-radius: 0.1em;
    box-shadow: 0 0 0 1px var(--accent);
  }
  .context-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    color: var(--c-fg);
    line-height: 1.35;
  }
  .context-text b {
    font-weight: 500;
  }
  .path {
    color: var(--c-muted);
  }
  .x {
    color: var(--c-muted);
  }

  .composer {
    flex: none;
    margin: 0 0.62em 0.62em;
    border-radius: 0.62em;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--edge);
  }
  .composer.is-focused {
    box-shadow:
      inset 0 0 0 1px var(--c-muted),
      0 0 0 0.23em var(--line-strong);
  }
  .composer p {
    min-height: 2.62em;
    padding: 0.46em 0.77em 0.31em;
  }
  .placeholder {
    color: var(--subtle);
  }
  .caret {
    display: inline-block;
    width: 1px;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--c-fg);
    animation: blink 1.06s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .panel :global(.foot) {
    display: flex;
    align-items: center;
    gap: 0.31em;
    padding: 0 0.62em 0.62em;
    color: var(--c-muted);
  }
  .panel :global(:is(.tool, .send)) {
    display: grid;
    place-items: center;
    width: 2.15em;
    height: 2.15em;
    border-radius: 0.46em;
  }
  .panel :global(.tool.is-auto) {
    background: var(--fill);
    color: var(--c-fg);
  }
  .panel :global(.model) {
    display: flex;
    align-items: center;
    gap: 0.46em;
    padding: 0 0.62em;
    font-size: 0.923em;
    white-space: nowrap;
  }
  .panel :global(.send) {
    background: var(--accent);
    color: var(--accent-fg);
  }
  .panel :global(.send.is-off) {
    background: var(--fill);
    color: var(--subtle);
  }
  .panel :global(.send.is-stop) {
    background: var(--raised);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--elevation-control);
    color: var(--c-fg);
  }

  .transcript {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.77em;
    padding: 0.92em;
    overflow: hidden;
  }
  /* What you sent: the picks, then your words in a bubble, on the right */
  .you {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.46em;
  }
  .you p {
    max-width: 87.5%;
    padding: 0.46em 0.92em;
    border-radius: 0.62em;
    background: var(--fill);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.36em;
    height: 1.82em;
    padding: 0 0.55em;
    border-radius: 0.36em;
    background: var(--fill);
    color: var(--c-muted);
    font-size: 0.846em;
  }
  .chip :global(svg) {
    width: 1.09em;
    height: 1.09em;
  }
  .chip b {
    color: var(--c-fg);
    font-weight: 500;
  }
  .chip code {
    font-size: 1em;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 0.62em;
    color: var(--c-muted);
    font-size: 0.923em;
  }
  .step code {
    color: var(--c-fg);
  }
  .step-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.23em;
    height: 1.23em;
  }
  .step.is-done .step-icon {
    color: var(--success);
  }
  .spinner {
    width: 0.92em;
    height: 0.92em;
    border-radius: 50%;
    border: 0.12em solid var(--line-strong);
    border-top-color: var(--accent);
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }
  .timer {
    font-variant-numeric: tabular-nums;
  }
  .diffstat {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.917em;
    white-space: nowrap;
  }
  .plus {
    color: var(--success);
  }
  .minus {
    color: var(--danger);
  }

  .reply {
    color: var(--c-fg);
  }
  .card {
    padding: 0.77em;
    border-radius: 0.62em;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.62em;
    margin-bottom: 0.77em;
  }
  figure {
    margin: 0;
    color: var(--c-muted);
    font-size: 0.846em;
  }
  .shot {
    display: flex;
    align-items: center;
    height: 2.9em;
    margin-top: 0.36em;
    padding: 0 0.9em;
    border-radius: 0.5em;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--fg);
    font-family: 'Inter Tight Variable', 'Inter Tight Fallback Light', 'Inter Tight Fallback', sans-serif;
    font-size: 1.6em;
    font-weight: 250;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .shot .bold {
    font-weight: 450;
  }
  .card-foot {
    display: flex;
    align-items: center;
    gap: 0.46em;
    color: var(--c-muted);
    font-size: 0.923em;
  }
  .card-foot .diffstat {
    margin-left: 0;
  }
  .buttons {
    display: flex;
    gap: 0.46em;
    margin-left: auto;
  }
  .buttons .button {
    margin-left: 0;
  }
  .nums {
    font-variant-numeric: tabular-nums;
  }

  /* 5. A narrated clip in the composer, its transcript as the message */
  .clip {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3.4em;
    height: 2.6em;
    overflow: hidden;
    border-radius: 0.3em;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .clip-card {
    position: absolute;
    left: 0.5em;
    top: 0.55em;
    width: 1.9em;
    height: 1.5em;
    border-radius: 0.2em;
    background: var(--raised);
    box-shadow: 0 0.1em 0.35em rgb(0 0 0 / 0.18);
  }
  .clip-play {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.38em;
    height: 1.38em;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-fg);
  }
  .clip-play :global(svg) {
    width: 0.7em;
    height: 0.7em;
  }

  /* 6. The agent's own screenshots, at two sizes */
  [data-kind='check'] .transcript {
    gap: 0.62em;
  }
  [data-kind='check'] .reply {
    margin-bottom: 0.62em;
  }
  .sizes {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 0.62em;
  }
  .mini {
    display: flex;
    gap: 0.3em;
    height: 3.4em;
    margin-top: 0.36em;
    padding: 0.4em;
    border-radius: 0.5em;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .mini i {
    flex: 1;
    border-radius: 0.2em;
    background: var(--fill);
  }
  .mini i:nth-child(2) {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .mini-stack {
    flex-direction: column;
    gap: 0.2em;
    width: 2.6em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.46em;
    height: 2.33em;
    margin-left: auto;
    padding: 0 0.83em;
    border-radius: 0.5em;
    background: var(--raised);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      var(--elevation-control);
    color: var(--c-fg);
    font-weight: 500;
  }
  .button.is-quiet {
    background: none;
    box-shadow: none;
    color: var(--c-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .caret, .spinner { animation: none; }
  }
</style>
