---
import Base from '../layouts/Base.astro'

// A page of text: the docs, the changelog, and the legal pages.
interface Props {
  title: string
  description: string
  path: string
  /** For a page that is changed by hand, such as the terms: when it last changed */
  updated?: string
}

const { title, description, path, updated } = Astro.props
---

<Base title={`${title} — Gui`} description={description} path={path}>
  <a class="mark" href="/" aria-label="Gui home page">
    <img src="/brand/gui-mark.svg" alt="" width="40" height="40" />
  </a>
  <h1>{title}</h1>
  {updated && <p class="updated">Updated {updated}</p>}
  <div class="prose"><slot /></div>
  <footer>
    <a href="/">Gui</a> · <a href="/docs">Docs</a> · <a href="/changelog">Changelog</a> ·{' '}
    <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a>
  </footer>
</Base>

<style>
  .mark {
    display: block;
    width: fit-content;
    margin-bottom: var(--s-5);
  }
  h1 {
    font-size: 2.5rem;
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 250;
    margin-bottom: var(--s-5);
  }
  h1:has(+ .updated) {
    margin-bottom: var(--s-2);
  }
  .updated {
    color: var(--muted);
    margin-bottom: var(--s-5);
  }
  .prose {
    max-width: 40rem;
  }
  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 400;
    margin: var(--s-5) 0 var(--s-3);
    scroll-margin-top: var(--s-4);
  }
  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: var(--s-3);
  }
  .prose :global(ul) {
    padding-left: var(--s-4);
  }
  .prose :global(li) {
    margin-bottom: var(--s-2);
  }
  .prose :global(strong) {
    font-weight: 400;
  }
  .prose :global(code) {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
  }
  footer {
    margin-top: var(--s-6);
    color: var(--muted);
  }
</style>
