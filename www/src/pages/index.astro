---
const title = 'Gui'
const description = 'Design real interfaces with your own AI agents.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <img class="mark" src="/favicon.svg" alt="Gui" width="40" height="40" />

      <p class="entry">
        <span class="word">Gui</span>
        <span class="ipa">/ˈɡuː.i/</span>
        <span class="say">goo·ee</span>
        <span>noun</span>
      </p>

      <blockquote>
        Gui is a browser-first Mac app for designing real interfaces with your own AI
        agents. Point at any element in your running app, ask for a change, and the agent edits
        your actual code. Made by <a href="https://bridger.to">Bridger Tower</a>.
      </blockquote>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --fg: #111;
    --muted: #666;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #191919;
      --fg: #f5f5f5;
      --muted: #a3a3a3;
    }
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  html {
    color-scheme: light dark;
  }
  body {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: 4rem 1.5rem;
    background: var(--bg);
    color: var(--fg);
    font-family: Menlo, ui-monospace, monospace;
    font-size: 1.25rem;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  main {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
  }
  .mark {
    display: block;
    margin-bottom: 4rem;
  }
  .entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 2rem;
    color: var(--muted);
  }
  .entry .word {
    color: var(--fg);
  }
  blockquote {
    text-wrap: pretty;
  }
  blockquote a {
    color: inherit;
    font-style: normal;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 1px;
  }
</style>
