---
import agents from '../assets/agents.png'
import agentsDark from '../assets/agents-dark.png'
import heroStillDark from '../assets/hero-start-dark.png'
import heroStillLight from '../assets/hero-start-light.png'
import mobile from '../assets/mobile.png'
import mobileDark from '../assets/mobile-dark.png'
import Demo from '../components/Demo.astro'
import HeroVideo from '../components/HeroVideo.astro'
import Shot from '../components/Shot.astro'
import StepUI from '../components/StepUI.astro'
import Base from '../layouts/Base.astro'

// The copy on this page is written in ASD-STE100 Simplified Technical English.
const site = 'https://usegui.com'
const title = 'Gui — Web design and UI design with your AI agent, on Mac'
const description =
  'Gui is a Mac app for web design and UI design. Select an element in your real app and tell your AI agent what to change. The agent changes the code.'

const agentNames = [
  'Claude Code',
  'Codex',
  'Cursor',
  'Amp',
  'OpenCode',
  'Grok Build',
  'Kiro',
  'Devin',
  'Pi',
  'Muse Code',
]

const tools = [
  'Select an element, or drag around an area of the page.',
  'Paste or drag a reference image into the chat. The agent sees it.',
  'Compare each change before and after.',
  'Undo a change, or redo it.',
  'Examine the page at desktop, laptop, tablet, and phone sizes.',
  'Record the page and send the clip to the agent.',
]

// Each step is drawn with Gui's own interface (StepUI), in the session of the "Try it now" demo.
const steps = [
  {
    name: 'Select an element on the page',
    text: 'Select the element that you want to change. Gui shows its tag and its size.',
    kind: 'select',
    label: 'Gui outlines the words “real app” in the headline and shows the label span, 130 × 49.',
  },
  {
    name: 'Describe the change in your own words',
    text: 'Write the change in the chat, in your words. The selected element goes with it.',
    kind: 'describe',
    label: 'The chat shows the selected span and the message: Make this semi-bold.',
  },
  {
    name: 'Watch the agent edit your code',
    text: 'The agent finds the file and changes the code. The chat shows each step.',
    kind: 'watch',
    label:
      'The chat shows the agent at work: it read and edited src/pages/index.astro, and a timer counts.',
  },
  {
    name: 'Compare before and after, then keep or undo',
    text: 'The page shows the change. Compare it before and after, then keep it or undo it.',
    kind: 'compare',
    label:
      'The chat shows “real app” before the change, light, and after it, semi-bold, with an Undo button.',
  },
] as const

const questions = [
  {
    q: 'Do I have to write code?',
    a: 'No. You select the element and write the change in your words. The agent finds the correct file and writes the code.',
  },
  {
    q: 'Which AI model does Gui use?',
    a: 'Gui does not include an AI model. It uses the agent that you select, with the model that you select.',
  },
  {
    q: 'Which apps can I change?',
    a: 'Gui shows each web app that runs on a local dev server. It finds the source file of each element for React apps (Vite and Next.js) and Astro sites.',
  },
  {
    q: 'Can I undo a change?',
    a: 'Yes. Before and after each change, Gui keeps a copy of your project files. Undo puts the files back. Gui does not change your git history.',
  },
  {
    q: 'How do I give the changes to my team?',
    a: 'Gui puts the changes on a new branch and opens a pull request. A developer can then examine the changes. Gui does not commit env files or keys.',
  },
  {
    q: 'Which computer do I need?',
    a: 'A Mac. Gui is a macOS app.',
  },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Gui',
      url: `${site}/`,
      publisher: { '@id': `${site}/#wip` },
    },
    {
      '@type': 'Organization',
      '@id': `${site}/#wip`,
      name: 'WIP',
      url: 'https://wip.is',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Gui',
      url: `${site}/`,
      description,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'macOS',
      image: `${site}/og.jpg`,
      publisher: { '@id': `${site}/#wip` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: questions.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
}

const wide = '(min-width: 72rem) 68rem, calc(100vw - 3rem)'
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
  <img class="mark" src="/mark-animated.svg" alt="" width="40" height="40" />

  <p class="entry">
    <span class="word">Gui</span>
    <span class="ipa">/ˈɡuː.i/</span>
    <span>noun</span>
  </p>

  <h1 class="lede">
    A Mac app for web design and UI design. Design on your <span data-demo-target>real app</span>,
    not on a mockup.
  </h1>
  <p class="sub">Select an element, then tell your AI agent what to change. The agent changes the code.</p>

  <div class="try">
    <button class="try-button" type="button" data-demo-open aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"
        ></path>
      </svg>
      Try it now
    </button>
    <span>A short demo on this page. You do not have to download anything.</span>
  </div>

  <figure class="wide">
    <HeroVideo
      light="/video/hero-light.mp4"
      dark="/video/hero-dark.mp4"
      stillLight={heroStillLight}
      stillDark={heroStillDark}
      sizes={wide}
      alt="Gui shows a website and the chat. The user selected two words in the headline. Claude Code changed the yellow highlight to an underline. The chat shows the text before and after the change."
    />
    <figcaption>A real session with Claude Code. The video shows the agent's work faster than real time.</figcaption>
  </figure>

  <section class="wide">
    <h2>How it works</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <StepUI kind={step.kind} label={step.label} />
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>For designers</h2>
    <p>
      You know how the interface must look. Gui lets you make that change in the product, not
      in a handoff file. You do not have to write code.
    </p>
    <ul class="list">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <section>
    <h2>Bring your own agent</h2>
    <p>
      Gui does not include an AI model. Gui uses the coding agent that is on your computer. The
      agent uses your login, your plan, and your configuration.
    </p>
    <ul class="agents">
      {agentNames.map((name) => <li>{name}</li>)}
    </ul>
    <p class="note">
      You can also use a different agent that uses <a
        href="https://agentclientprotocol.com"
        target="_blank"
        rel="noopener"><abbr title="Agent Client Protocol">ACP</abbr></a
      >. To change the agent, select a different agent in the chat header.
    </p>
  </section>

  <figure class="narrow">
    <Shot
      light={agents}
      dark={agentsDark}
      widths={[760, 1520]}
      sizes="(min-width: 42rem) 38rem, calc(100vw - 3rem)"
      alt="The Agents settings in Gui. Claude Code, Codex, Grok Build, OpenCode, Pi, and Muse Code show the status Ready. Kiro, Amp, and Devin are not installed."
    />
    <figcaption>Gui finds each agent on your computer and shows its status.</figcaption>
  </figure>

  <section>
    <h2>Your real app</h2>
    <p>
      Gui starts the dev server of your project and shows the real page, with real data and real
      states. The agent writes each change in your code. When the design is satisfactory, Gui
      opens a pull request for your team.
    </p>
  </section>

  <figure class="wide">
    <Shot
      light={mobile}
      dark={mobileDark}
      widths={[960, 1440, 2880]}
      sizes={wide}
      alt="The same website in the Mobile frame of Gui, at 390 × 844 pixels. The chat is open next to the frame."
    />
    <figcaption>Examine the page at the size of a phone. The chat stays open.</figcaption>
  </figure>

  <section>
    <h2>Questions</h2>
    <dl class="faq">
      {
        questions.map(({ q, a }) => (
          <div>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <footer>
    <a href="https://wip.is" target="_blank" rel="noopener">WIP</a> makes Gui.
  </footer>

  <Demo slot="after" />
</Base>

<style>
  .mark {
    display: block;
    margin-bottom: var(--s-5);
  }
  .entry {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
    color: var(--muted);
  }
  .entry .word {
    color: var(--fg);
    font-weight: 400;
  }
  /* Inter Tight's Latin subset has no IPA; the system font does, so no second file loads. */
  .ipa {
    font-family: ui-sans-serif, -apple-system, 'Helvetica Neue', sans-serif;
    font-weight: 300;
  }
  .lede {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 250;
    max-width: 34rem;
    text-wrap: balance;
  }
  /* The words the demo selects: on one line, so their outline is a single box. */
  .lede [data-demo-target] {
    white-space: nowrap;
  }
  .sub {
    margin-top: var(--s-3);
    color: var(--muted);
  }
  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-4);
  }
  .try span {
    font-size: 0.875rem;
    font-weight: 380;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  .try-button {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.625rem 1.125rem 0.625rem 0.875rem;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: inherit;
    font-size: 1rem;
    font-weight: 420;
    letter-spacing: -0.005em;
    cursor: pointer;
    transition:
      opacity 120ms cubic-bezier(0.2, 0, 0, 1),
      transform 120ms cubic-bezier(0.2, 0, 0, 1);
  }
  .try-button svg {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .try-button:hover {
    opacity: 0.86;
  }
  .try-button:active {
    transform: scale(0.97);
  }
  .try-button:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  figure {
    margin-top: var(--s-5);
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .narrow {
    max-width: 38rem;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-5) var(--s-4);
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  .steps h3 {
    margin-top: var(--s-3);
    font-weight: 400;
  }
  .steps p {
    color: var(--muted);
    max-width: 30rem;
  }
  /* Small text: a heavier weight and slightly open tracking, so thin grey strokes still read. */
  figcaption,
  footer {
    font-size: 0.875rem;
    font-weight: 380;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  figcaption {
    margin-top: var(--s-3);
    max-width: 40rem;
  }
  section {
    margin-top: var(--s-6);
  }
  h2 {
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 400;
    margin-bottom: var(--s-3);
  }
  h2::before {
    content: '§\2009';
    color: var(--muted);
    font-weight: 300;
  }
  section p + *,
  section ul + * {
    margin-top: var(--s-3);
  }
  .list,
  .agents {
    list-style: none;
    padding: 0;
  }
  .list li {
    padding: var(--s-2) 0;
    border-top: 1px solid var(--rule);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .list li::before,
  .agents li::before {
    content: '+\2009';
    color: var(--muted);
  }
  .agents {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--s-1) var(--s-4);
  }
  .note {
    color: var(--muted);
  }
  .faq {
    display: grid;
    gap: var(--s-4);
  }
  .faq dt {
    font-weight: 400;
  }
  .faq dd {
    margin-top: var(--s-1);
    color: var(--muted);
  }
  footer {
    margin-top: var(--s-6);
  }
</style>
