---
import agents from '../assets/agents.png'
import agentsDark from '../assets/agents-dark.png'
import heroStillDark from '../assets/hero-start-dark.png'
import heroStillLight from '../assets/hero-start-light.png'
import mobile from '../assets/mobile.png'
import mobileDark from '../assets/mobile-dark.png'
import Demo from '../components/Demo.astro'
import HeroVideo from '../components/HeroVideo.astro'
import Shot from '../components/Shot.astro'
import StepUI from '../components/StepUI.astro'
import Base from '../layouts/Base.astro'

// The copy on this page is written in ASD-STE100 Simplified Technical English.
const site = 'https://usegui.com'
const title = 'Gui — Web design and UI design with your AI agent, on Mac'
const description =
  'Gui is a Mac app for web design and UI design. Select an element in your real app and tell your AI agent what to change. The agent changes the code.'

const agentNames = [
  'Claude Code',
  'Codex',
  'Cursor',
  'Amp',
  'OpenCode',
  'Grok Build',
  'Kiro',
  'Devin',
  'Pi',
  'Muse Code',
]

const tools = [
  'Select an element, or drag around an area of the page.',
  'Paste or drag a reference image into the chat. The agent sees it.',
  'Compare each change before and after.',
  'Undo a change, or redo it.',
  'Examine the page at desktop, laptop, tablet, and phone sizes.',
  'Record the page and send the clip to the agent.',
]

// Each step is drawn with Gui's own interface (StepUI), in the session of the "Try it now" demo.
const steps = [
  {
    name: 'Select an element on the page',
    text: 'Select the element that you want to change. Gui shows its tag and its size.',
    kind: 'select',
    label: 'Gui outlines the words “real app” in the headline and shows the label span, 130 × 49.',
  },
  {
    name: 'Describe the change in your own words',
    text: 'Write the change in the chat, in your words. The selected element goes with it.',
    kind: 'describe',
    label: 'The chat shows the selected span and the message: Make this semi-bold.',
  },
  {
    name: 'Watch the agent edit your code',
    text: 'The agent finds the file and changes the code. The chat shows each step.',
    kind: 'watch',
    label:
      'The chat shows the agent at work: it read and edited src/pages/index.astro, and a timer counts.',
  },
  {
    name: 'Compare before and after, then keep or undo',
    text: 'The page shows the change. Compare it before and after, then keep it or undo it.',
    kind: 'compare',
    label:
      'The chat shows “real app” before the change, light, and after it, semi-bold, with an Undo button.',
  },
] as const

const questions = [
  {
    q: 'Do I have to write code?',
    a: 'No. You select the element and write the change in your words. The agent finds the correct file and writes the code.',
  },
  {
    q: 'Which AI model does Gui use?',
    a: 'Gui does not include an AI model. It uses the agent that you select, with the model that you select.',
  },
  {
    q: 'Which apps can I change?',
    a: 'Gui shows each web app that runs on a local dev server. It finds the source file of each element for React apps (Vite and Next.js) and Astro sites.',
  },
  {
    q: 'Can I undo a change?',
    a: 'Yes. Before and after each change, Gui keeps a copy of your project files. Undo puts the files back. Gui does not change your git history.',
  },
  {
    q: 'How do I give the changes to my team?',
    a: 'Gui puts the changes on a new branch and opens a pull request. A developer can then examine the changes. Gui does not commit env files or keys.',
  },
  {
    q: 'Which computer do I need?',
    a: 'A Mac. Gui is a macOS app.',
  },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Gui',
      url: `${site}/`,
      publisher: { '@id': `${site}/#wip` },
    },
    {
      '@type': 'Organization',
      '@id': `${site}/#wip`,
      name: 'WIP',
      url: 'https://wip.is',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Gui',
      url: `${site}/`,
      description,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'macOS',
      image: `${site}/og.jpg`,
      publisher: { '@id': `${site}/#wip` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: questions.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
}

const wide = '(min-width: 72rem) 68rem, calc(100vw - 3rem)'
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
  <div class="brand wide">
    <img class="mark" src="/mark-animated.svg" alt="" width="40" height="40" />
    <span class="wordmark">Gui</span>
    <span class="pill">Alpha</span>
  </div>

  <h1 class="lede">
    An agent harness for web design and UI design.{' '}<br />
    Design on your <span data-demo-target>real app</span>, not on a mockup.
  </h1>
  <p class="sub">Iterate the details with the agent harness built for designers and visual engineers.</p>

  <div class="try">
    <a class="try-button download-button" href="/download">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
      </svg>
      Download for Mac
    </a>
    <button class="try-button" type="button" data-demo-open aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"
        ></path>
      </svg>
      Try it now
    </button>
  </div>

  <section class="waitlist" id="waitlist">
    <p>
      Windows and Linux are coming soon.{' '}
      <button class="waitlist-open" type="button" commandfor="waitlist-dialog" command="show-modal">
        Sign up for the waitlist
      </button>
    </p>
    <p class="waitlist-joined" id="waitlist-joined">You are on the waitlist. We send you an email when Gui is available.</p>
  </section>

  <dialog class="waitlist-dialog" id="waitlist-dialog" closedby="any" aria-labelledby="waitlist-title">
    <button class="waitlist-close" type="button" commandfor="waitlist-dialog" command="close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <h2 id="waitlist-title">Gui for Windows and Linux</h2>
    <form class="waitlist-form" action="/waitlist" method="post" data-waitlist>
      <p>Sign up for the waitlist. We send you one email when Gui is available on your platform.</p>
      <label class="waitlist-field">
        <span>Email</span>
        <input
          type="email"
          name="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder="you@example.com"
          autofocus
        />
      </label>
      <fieldset class="waitlist-field">
        <legend>Platform</legend>
        <div class="waitlist-platforms">
          <label><input type="radio" name="platform" value="windows" checked />Windows</label>
          <label><input type="radio" name="platform" value="linux" />Linux</label>
        </div>
      </fieldset>
      <!-- People don't see this field; bots fill it in, and the worker does not save them. -->
      <input class="waitlist-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="waitlist-status" role="status" data-waitlist-status></p>
      <button class="waitlist-submit" type="submit">Sign up</button>
    </form>
    <div class="waitlist-done" data-waitlist-done hidden>
      <p>You are on the waitlist. We send you an email when Gui is available.</p>
      <button class="waitlist-submit" type="button" commandfor="waitlist-dialog" command="close">Done</button>
    </div>
  </dialog>

  <figure class="wide">
    <HeroVideo
      light="/video/hero-light.mp4"
      dark="/video/hero-dark.mp4"
      stillLight={heroStillLight}
      stillDark={heroStillDark}
      sizes={wide}
      alt="Gui shows a website and the chat. The user selected two words in the headline. Claude Code changed the yellow highlight to an underline. The chat shows the text before and after the change."
    />
    <figcaption>A real session with Claude Code. The video shows the agent's work faster than real time.</figcaption>
  </figure>

  <section class="wide">
    <h2>How it works</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <StepUI kind={step.kind} label={step.label} />
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>For designers</h2>
    <p>
      You know how the interface must look. Gui lets you make that change in the product, not
      in a handoff file. You do not have to write code.
    </p>
    <ul class="list">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <section>
    <h2>Bring your own agent</h2>
    <p>
      Gui does not include an AI model. Gui uses the coding agent that is on your computer. The
      agent uses your login, your plan, and your configuration.
    </p>
    <ul class="agents">
      {agentNames.map((name) => <li>{name}</li>)}
    </ul>
    <p class="note">
      You can also use a different agent that uses <a
        href="https://agentclientprotocol.com"
        target="_blank"
        rel="noopener"><abbr title="Agent Client Protocol">ACP</abbr></a
      >. To change the agent, select a different agent in the chat header.
    </p>
  </section>

  <figure class="narrow">
    <Shot
      light={agents}
      dark={agentsDark}
      widths={[760, 1520]}
      sizes="(min-width: 42rem) 38rem, calc(100vw - 3rem)"
      framed
      alt="The Agents settings in Gui. Claude Code, Codex, Grok Build, OpenCode, Pi, and Muse Code show the status Ready. Kiro, Amp, and Devin are not installed."
    />
    <figcaption>Gui finds each agent on your computer and shows its status.</figcaption>
  </figure>

  <section>
    <h2>Your real app</h2>
    <p>
      Gui starts the dev server of your project and shows the real page, with real data and real
      states. The agent writes each change in your code. When the design is satisfactory, Gui
      opens a pull request for your team.
    </p>
  </section>

  <figure class="wide">
    <Shot
      light={mobile}
      dark={mobileDark}
      widths={[960, 1440, 2880]}
      sizes={wide}
      framed
      alt="The same website in the Mobile frame of Gui, at 390 × 844 pixels. The chat is open next to the frame."
    />
    <figcaption>Examine the page at the size of a phone. The chat stays open.</figcaption>
  </figure>

  <section>
    <h2>Questions</h2>
    <dl class="faq">
      {
        questions.map(({ q, a }) => (
          <div>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <footer>
    <a href="https://wip.is" target="_blank" rel="noopener">WIP</a> makes Gui.
    <a class="brand-link" href="/brand">Brand assets</a>
  </footer>

  <Demo slot="after" />
</Base>

<script>
  // Signs up without leaving the page. Without this script, the form posts to /waitlist and the
  // worker sends the browser back to #waitlist-joined.
  const dialog = document.querySelector<HTMLDialogElement>('#waitlist-dialog')!
  const form = dialog.querySelector<HTMLFormElement>('[data-waitlist]')!
  const done = dialog.querySelector<HTMLElement>('[data-waitlist-done]')!
  const status = dialog.querySelector<HTMLElement>('[data-waitlist-status]')!

  // Browsers without invoker commands (commandfor) open and close the dialog here instead.
  if (!('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('[commandfor="waitlist-dialog"]').forEach((button) =>
      button.addEventListener('click', () =>
        button.getAttribute('command') === 'show-modal' ? dialog.showModal() : dialog.close(),
      ),
    )
  }
  // And without closedby="any", a click on the backdrop closes it here. A click on the backdrop
  // and a click on the dialog's padding both target the dialog, so the click's position decides.
  if (!('closedBy' in HTMLDialogElement.prototype)) {
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect()
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom
      if (event.target === dialog && !inside) dialog.close()
    })
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    button.disabled = true
    status.textContent = ''
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { accept: 'application/json' },
    }).catch(() => null)
    const result = (await response?.json().catch(() => null)) as { ok?: boolean; error?: string } | null
    button.disabled = false
    if (result?.ok) {
      form.hidden = true
      done.hidden = false
      done.querySelector('button')!.focus()
    } else {
      status.textContent = result?.error ?? 'Gui could not save your address. Try again.'
    }
  })

  // The next time the dialog opens, it starts with an empty form.
  dialog.addEventListener('close', () => {
    if (form.hidden) {
      form.reset()
      form.hidden = false
      done.hidden = true
    }
  })
</script>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .mark {
    display: block;
  }
  .wordmark {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
    animation: wordmark-reveal 350ms ease-out 725ms both;
  }
  .pill {
    margin-left: auto;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--muted);
  }
  @keyframes wordmark-reveal {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wordmark {
      animation: none;
    }
  }
  .lede {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 250;
    max-width: 34rem;
    text-wrap: balance;
  }
  /* Each sentence on its own line, once the column can hold the longer one. */
  @media (min-width: 64rem) {
    .lede {
      max-width: max-content;
      text-wrap: nowrap;
    }
  }
  @media (max-width: 63.99rem) {
    .lede br {
      display: none;
    }
  }
  /* The words the demo selects: on one line, so their outline is a single box. */
  .lede [data-demo-target] {
    white-space: nowrap;
  }
  .sub {
    margin-top: var(--s-3);
    color: var(--muted);
  }
  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-4);
  }
  .waitlist {
    margin-top: var(--s-4);
    color: var(--muted);
    font-size: 1rem;
  }
  .waitlist-open {
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
    cursor: pointer;
  }
  @media (hover: hover) {
    .waitlist-open:hover {
      text-decoration-color: currentColor;
    }
  }
  /* Without the script, the form posts and the worker sends the browser back to #waitlist-joined. */
  .waitlist-joined {
    display: none;
    margin-top: var(--s-2);
    color: var(--fg);
  }
  .waitlist-joined:target {
    display: block;
  }

  .waitlist-dialog {
    /* The global reset removes the margin that centers a modal dialog. */
    margin: auto;
    width: min(26rem, calc(100vw - 2 * var(--s-4)));
    padding: var(--s-4);
    border: 1px solid var(--rule);
    border-radius: 1rem;
    background: var(--bg);
    color: var(--fg);
    font-size: 1rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
  }
  /* The page behind the open dialog does not scroll. */
  :global(html:has(.waitlist-dialog[open])) {
    overflow: hidden;
  }
  /* On a phone, the dialog sits near the top, so the keyboard does not cover the email field. */
  @media (max-width: 40rem) {
    .waitlist-dialog {
      margin-top: var(--s-5);
    }
  }
  .waitlist-dialog::backdrop {
    background: rgba(0, 0, 0, 0.32);
  }
  .waitlist-dialog[open] {
    animation: waitlist-in 160ms cubic-bezier(0.2, 0, 0, 1);
  }
  @keyframes waitlist-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .waitlist-dialog[open] {
      animation: none;
    }
  }
  .waitlist-dialog h2 {
    padding-right: var(--s-5);
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .waitlist-dialog h2::before {
    content: none;
  }
  .waitlist-dialog p {
    color: var(--muted);
  }
  .waitlist-close {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  @media (hover: hover) {
    .waitlist-close:hover {
      background: var(--rule);
      color: var(--fg);
    }
    .waitlist-submit:hover {
      opacity: 0.86;
    }
  }
  .waitlist-close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .waitlist-form,
  .waitlist-done {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .waitlist-form[hidden],
  .waitlist-done[hidden] {
    display: none;
  }
  .waitlist-field {
    display: grid;
    gap: var(--s-1);
    min-width: 0;
    padding: 0;
    border: 0;
  }
  .waitlist-field > span,
  .waitlist-field legend {
    padding: 0;
    margin-bottom: var(--s-1);
    font-size: 0.875rem;
    font-weight: 400;
  }
  .waitlist-field input[type='email'] {
    /* WebKit gives an email field a minimum width that is wider than a phone's dialog. */
    width: 100%;
    min-width: 0;
    height: 2.5rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    font: inherit;
  }
  .waitlist-field input[type='email']::placeholder {
    color: var(--muted);
  }
  .waitlist-platforms {
    display: flex;
    gap: var(--s-2);
  }
  .waitlist-platforms label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 2.5rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
  }
  .waitlist-platforms label:has(:checked) {
    border-color: var(--fg);
  }
  .waitlist-platforms input {
    margin: 0;
    accent-color: var(--fg);
  }
  .waitlist-submit {
    justify-self: start;
    height: 2.5rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: inherit;
    font-weight: 420;
    cursor: pointer;
    transition: opacity 120ms cubic-bezier(0.2, 0, 0, 1);
  }
  .waitlist-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .waitlist-dialog :is(input, button):focus-visible,
  .waitlist-open:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .waitlist-platforms input:focus-visible {
    outline-offset: 1px;
  }
  .waitlist-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .waitlist-status:empty {
    display: none;
  }
  .waitlist-dialog .waitlist-status {
    color: #d93025;
  }
  .try-button {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.625rem 1.125rem 0.625rem 0.875rem;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font: inherit;
    font-size: 1rem;
    font-weight: 420;
    letter-spacing: -0.005em;
    text-decoration: none;
    cursor: pointer;
    transition:
      opacity 120ms cubic-bezier(0.2, 0, 0, 1),
      transform 120ms cubic-bezier(0.2, 0, 0, 1);
  }
  .try-button svg {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .download-button {
    background: #0066ff;
    color: #fff;
    min-width: 10.25rem;
    justify-content: center;
  }
  .download-button svg {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .try-button:hover {
    opacity: 0.86;
  }
  .try-button:active {
    transform: scale(0.97);
  }
  .try-button:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  figure {
    margin-top: var(--s-5);
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .narrow {
    max-width: 38rem;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-5) var(--s-4);
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  .steps h3 {
    margin-top: var(--s-3);
    font-weight: 400;
  }
  .steps p {
    color: var(--muted);
    max-width: 30rem;
  }
  /* Small text: a heavier weight and slightly open tracking, so thin grey strokes still read. */
  figcaption,
  footer {
    font-size: 0.875rem;
    font-weight: 380;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  figcaption {
    margin-top: var(--s-3);
    max-width: 40rem;
  }
  section {
    margin-top: var(--s-6);
  }
  h2 {
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 400;
