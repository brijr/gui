---
import agents from '../assets/agents.png'
import agentsDark from '../assets/agents-dark.png'
import canvas from '../assets/canvas.png'
import canvasDark from '../assets/canvas-dark.png'
import heroStillDark from '../assets/hero-start-dark.png'
import heroStillLight from '../assets/hero-start-light.png'
import mobile from '../assets/mobile.png'
import mobileDark from '../assets/mobile-dark.png'
import ShapeLogo from '../assets/shape-logo.svg'
import Demo from '../components/Demo.astro'
import HeroVideo from '../components/HeroVideo.astro'
import Shot from '../components/Shot.astro'
import StepUI from '../components/StepUI.astro'
import Base from '../layouts/Base.astro'

// The copy on this page is written in ASD-STE100 Simplified Technical English.
const site = 'https://usegui.com'
// Where feedback goes: a direct message on X.
const feedback = 'https://x.com/bridgertower'
const github = 'https://github.com/brijr/gui'
const title = 'Gui — Web design and UI design with your AI agent, on Mac'
const description =
  'Gui is a Mac app for web design and UI design. Select an element in your real app and tell your AI agent what to change. The agent changes the code.'

const agentNames = [
  'Claude Code',
  'Codex',
  'Cursor',
  'Amp',
  'OpenCode',
  'Grok Build',
  'Kiro',
  'Devin',
  'Pi',
  'Muse Code',
  'fx',
]

const tools = [
  'Select an element, or drag around an area of the page. Hold Shift to select more than one.',
  'Paste or drag a reference image into the chat. The agent sees it.',
  'Send more messages while the agent works. They wait in a queue.',
  'Copy or save a screenshot of the page, or attach it to the chat.',
  'Hide all of Gui except the page, with focus mode.',
]

// Each step is drawn with Gui's own interface (StepUI), in the session of the "Try it now" demo.
const steps = [
  {
    name: 'Select an element on the page',
    text: 'Select the element that you want to change. Gui shows its tag and its size.',
    kind: 'select',
    label: 'Gui outlines the words “real app” in the headline and shows the label span, 130 × 49.',
  },
  {
    name: 'Describe the change in your own words',
    text: 'Write the change in the chat, in your words. The selected element goes with it.',
    kind: 'describe',
    label: 'The chat shows the selected span and the message: Make this semi-bold.',
  },
  {
    name: 'Watch the agent edit your code',
    text: 'The agent finds the file and changes the code. The chat shows each step.',
    kind: 'watch',
    label:
      'The chat shows the agent at work: it read and edited src/pages/index.astro, and a timer counts.',
  },
  {
    name: 'Compare before and after, then keep, undo, or follow up',
    text: 'The page shows the change. Compare it before and after. Keep it, undo it, or click Follow up to ask for more.',
    kind: 'compare',
    label:
      'The chat shows “real app” before the change, light, and after it, semi-bold, with Follow up and Undo buttons.',
  },
] as const

const questions = [
  {
    q: 'What does Gui cost?',
    a: 'Gui is free to use during alpha. It connects to your own AI coding agent. You pay your agent provider under your existing account and plan; Gui adds no AI usage charges. Gui is open source under the Apache 2.0 license.',
  },
  {
    q: 'Which AI model does Gui use?',
    a: 'Gui does not include an AI model. It uses the agent that you select, with the model that you select.',
  },
  {
    q: 'Which apps can I change?',
    a: 'Gui shows each web app that runs on a local dev server. It finds the source file of each element for React apps (Vite and Next.js) and Astro sites.',
  },
  {
    q: 'Can I undo a change?',
    a: 'Yes. Before and after each change, Gui keeps a copy of your project files. Undo puts the files back. Gui does not change your git history.',
  },
  {
    q: 'How do I give the changes to my team?',
    a: 'Ask your agent to commit the changes and open a pull request. Gui does not change your git history.',
  },
  {
    q: 'Does Gui listen to my microphone all the time?',
    a: 'No. Gui uses the microphone only while you record with Narrate on. Your Mac makes the transcript, so your voice does not go to a server. Your web app cannot use the microphone.',
  },
  {
    q: 'Which computer do I need?',
    a: 'A Mac with Apple silicon (M1 or later) and macOS 13 or later. Recordings with your voice need macOS 26 or later.',
  },
]

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Gui',
      url: `${site}/`,
      publisher: { '@id': `${site}/#wip` },
    },
    {
      '@type': 'Organization',
      '@id': `${site}/#wip`,
      name: 'WIP',
      legalName: 'Work In Progress LLC',
      url: 'https://wip.is',
      email: 'hello@usegui.com',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Gui',
      url: `${site}/`,
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      applicationCategory: 'DesignApplication',
      operatingSystem: 'macOS',
      downloadUrl: `${site}/download`,
      image: `${site}/og.jpg`,
      publisher: { '@id': `${site}/#wip` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: questions.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
}

const wide = '(min-width: 72rem) 68rem, calc(100vw - 3rem)'
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
  <div class="brand wide">
    <img class="mark intro-animated" src="/mark-animated.svg" alt="" width="40" height="40" />
    <img class="mark intro-static" src="/brand/gui-mark.svg" alt="" width="40" height="40" />
    <span class="wordmark">Gui</span>
    <span class="pill">Alpha</span>
  </div>
  <script is:inline>
    // The wordmark's fade waits for the mark: its animation starts when the image loads, which
    // on a slow first visit can be after the wordmark's delay has run out.
    ;(() => {
      const mark = document.querySelector('.intro-animated')
      if (!mark || mark.complete) return
      const root = document.documentElement
      root.classList.add('mark-loading')
      const done = () => root.classList.remove('mark-loading')
      mark.addEventListener('load', done, { once: true })
      mark.addEventListener('error', done, { once: true })
    })()
  </script>

  <h1 class="lede">
    Design on your <span data-demo-target>real app</span>.{' '}<br />
    Tell your AI coding agent what to change.
  </h1>
  <p class="sub">Gui is a Mac app. Select an element, describe a change, and your AI coding agent edits the code. Start with a canvas or open a project.</p>


  <div class="try">
    <a class="try-button download-button" href="/download">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
      </svg>
      Download for Mac
    </a>
    <button class="try-button" type="button" data-demo-open aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"
        ></path>
      </svg>
      Try it now
    </button>
  </div>

  <p class="download-help" data-download-help hidden role="status">
    After the download finishes, open Gui.dmg, drag Gui to Applications, then open Gui. Sign in, choose an agent, and select New canvas to start.
  </p>

  <!-- Phones are sent here by the worker when there is no script to open the dialog. -->
  <p class="mac-only" id="mac-only">Gui is a Mac app. Open usegui.com on your Mac to download it.</p>

  <section class="waitlist" id="waitlist">
    <p>
      For Macs with Apple silicon and macOS 13 or later. Gui is{' '}
      <a href={github} target="_blank" rel="noopener">open source</a>. Windows and Linux are coming soon.{' '}
      <button class="waitlist-open" type="button" commandfor="waitlist-dialog" command="show-modal">
        Sign up for the waitlist
      </button>
    </p>
    <p class="waitlist-joined" id="waitlist-joined">You are on the waitlist. We send you an email when Gui is available.</p>
  </section>

  <dialog class="dialog" id="mac-dialog" closedby="closerequest" aria-labelledby="mac-title" autofocus>
    <button class="dialog-close" type="button" commandfor="mac-dialog" command="close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <h2 id="mac-title">Gui is a Mac app</h2>
    <div class="dialog-body">
      <p>You cannot install Gui on this device. Open usegui.com on your Mac to download it.</p>
      <button class="dialog-button" type="button" data-share>Send the link to your Mac</button>
      <p class="dialog-note">
        Windows and Linux are coming soon.{' '}
        <button class="waitlist-open" type="button" commandfor="waitlist-dialog" command="show-modal" data-mac-waitlist>
          Sign up for the waitlist
        </button>
      </p>
    </div>
  </dialog>

  <dialog class="dialog" id="waitlist-dialog" closedby="closerequest" aria-labelledby="waitlist-title">
    <button class="dialog-close" type="button" commandfor="waitlist-dialog" command="close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <h2 id="waitlist-title">Gui for Windows and Linux</h2>
    <form class="waitlist-form" action="/waitlist" method="post" data-waitlist>
      <p>Sign up for the waitlist. We send you one email when Gui is available on your platform.</p>
      <label class="waitlist-field">
        <span>Email</span>
        <input
          type="email"
          name="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder="you@example.com"
          autofocus
        />
      </label>
      <fieldset class="waitlist-field">
        <legend>Platform</legend>
        <div class="waitlist-platforms">
          <label><input type="radio" name="platform" value="windows" checked />Windows</label>
          <label><input type="radio" name="platform" value="linux" />Linux</label>
        </div>
      </fieldset>
      <!-- People don't see this field; bots fill it in, and the worker does not save them. -->
      <input class="waitlist-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="waitlist-status" role="status" data-waitlist-status></p>
      <button class="dialog-button" type="submit">Sign up</button>
    </form>
    <div class="waitlist-done" data-waitlist-done hidden>
      <p>You are on the waitlist. We send you an email when Gui is available.</p>
      <button class="dialog-button" type="button" commandfor="waitlist-dialog" command="close">Done</button>
    </div>
  </dialog>

  <figure class="wide">
    <HeroVideo
      light="/video/hero-light.mp4"
      dark="/video/hero-dark.mp4"
      stillLight={heroStillLight}
      stillDark={heroStillDark}
      sizes={wide}
      alt="Gui shows a website and the chat. The user selected two words in the headline. Claude Code changed the yellow highlight to an underline. The chat shows the text before and after the change."
    />
    <figcaption>A real session with Claude Code. The video shows the agent’s work faster than real time.</figcaption>
  </figure>

  <section class="wide">
    <h2>How it works</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <StepUI kind={step.kind} label={step.label} />
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="cost">
    <h2>Cost and setup</h2>
    <p>Gui is free to use during alpha. Connect your own AI coding agent and use your existing account and plan. You pay the agent provider directly; Gui adds no AI usage charges.</p>
    <p>The Mac app needs a Gui account and an AI coding agent. Gui can install Claude Code or Codex and help you sign in. You can start with New canvas without a project.</p>
  </section>

  <section>
    <h2>Your app is the workspace</h2>
    <p>
      In most agent apps, the browser is a panel next to the chat. In Gui, your app fills the
      window and the chat floats on it. You look at the design, not at the code.
    </p>
    <p>
      Open a project folder. Gui installs the dependencies, starts the dev server, and shows the
      real page, with real data and real states. In a monorepo, Gui asks which app to show. You do
      not have to configure Gui.
    </p>
  </section>

  <section>
    <h2>Show the agent how it moves</h2>
    <p>
      Some changes are difficult to write, for example an animation. Record the page, and speak
      while you point at the problem. Gui writes down what you said. You can correct the text
      before you send it.
    </p>
    <p>
      The agent gets the clip, your words, and the position of your pointer when you spoke. It
      can examine each frame of the animation.
    </p>
  </section>

  <figure class="narrow">
    <StepUI
      kind="narrate"
      label="The composer shows Recording 1, 14.2 seconds, narrated. The message is what the user said: This card slides in too fast. And here, at the end, the shadow comes in after the card stops."
    />
    <figcaption>Gui puts what you said in the message.</figcaption>
  </figure>

  <section>
    <h2>The agent examines its work</h2>
    <p>
      After each change, the agent makes screenshots of the page and examines them. It clicks,
      types, and scrolls in the page that you see. When a change is not correct, the agent fixes
      it before it replies.
    </p>
    <p>
      The agent knows which size you look at: desktop, laptop, tablet, or phone. Errors from the
      console and the build show above the chat, with a Fix button.
    </p>
  </section>

  <figure class="narrow">
    <StepUI
      kind="check"
      label="The user asked: Put the three plans in one row. The agent edited Plans.tsx, made screenshots at 1440 by 900 and 390 by 844, and edited the file again. It replied: The plans are in one row. They did not fit on a phone, so they stack there. Two small screenshots show the row at 1440 wide and the stack at 390 wide."
    />
    <figcaption>The agent found a problem at the phone size and fixed it before it replied.</figcaption>
  </figure>

  <figure class="wide">
    <Shot
      light={mobile}
      dark={mobileDark}
      widths={[960, 1440, 2880]}
      sizes={wide}
      framed
      alt="The same website in the Mobile frame of Gui, at 390 × 844 pixels. The chat is open next to the frame."
    />
    <figcaption>Examine the page at the size of a phone. The chat stays open.</figcaption>
  </figure>

  <section>
    <h2>Design on a canvas</h2>
    <p>
      Open a canvas to design without a project, a folder, or a dev server. Ask the agent for a
      page, or for some versions of a page. Each version is a frame on the board, as artboards are
      in Figma.
    </p>
    <p>
      Move, resize, and compare the frames, and put related frames in a section. Export frames as
      PNG files, or make a frame into a Vite project. The agent can also make a screenshot of a
      different website, for example “make it feel like linear.app”, and use it as a reference.
    </p>
  </section>

  <figure class="wide">
    <Shot
      light={canvas}
      dark={canvasDark}
      widths={[960, 1440, 2880]}
      sizes={wide}
      framed
      alt="A canvas in Gui with four frames, as artboards: three desktop versions of a landing page for Kiln, a booking app for pottery studios, and a phone version. One frame is selected. In the chat, the user asked Claude Code for three versions of the page with the same text, and a phone version of the first."
    />
    <figcaption>Ask for some versions of a page, then compare them on one board.</figcaption>
  </figure>

  <section>
    <h2>For designers</h2>
    <p>
      You know how the interface must look. Gui lets you make that change in the product, not
      in a handoff file. You do not have to write code.
    </p>
    <ul class="list">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <section>
    <h2>Bring your own agent</h2>
    <p>
      Gui does not include an AI model, and it does not lock you in to one agent. Gui uses the
      coding agent that is on your computer. The agent uses your login, your plan, and your
      configuration.
    </p>
    <ul class="agents">
      {agentNames.map((name) => <li>{name}</li>)}
    </ul>
    <p class="note">
      You can also use a different agent that uses <a
        href="https://agentclientprotocol.com"
        target="_blank"
        rel="noopener"><abbr title="Agent Client Protocol">ACP</abbr></a
      >. To change the agent, select a different agent in the chat header.
    </p>
  </section>

  <figure class="narrow">
    <Shot
      light={agents}
      dark={agentsDark}
      widths={[760, 1520]}
      sizes="(min-width: 42rem) 38rem, calc(100vw - 3rem)"
      framed
      alt="The Agents settings in Gui. Claude Code, Codex, Grok Build, OpenCode, Pi, and Muse Code show the status Ready. Kiro, Amp, and Devin are not installed."
    />
    <figcaption>Gui finds each agent on your computer and shows its status.</figcaption>
  </figure>

  <section>
    <h2>Questions</h2>
    <dl class="faq">
      {
        questions.map(({ q, a }) => (
          <div>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <h2>Tell us what to fix</h2>
    <p>
      Gui is in alpha. Tell us what is wrong or what is missing, and we fix it.{' '}
      <a href={feedback} target="_blank" rel="noopener">Send a message on X</a>.
    </p>
  </section>

  <footer>
    <a class="sponsor" href="https://shapefs.com" target="_blank" rel="noopener">
      Sponsored by <ShapeLogo class="sponsor-logo" role="img" aria-label="Shape" />
    </a>
    <div class="footer-links">
      <span><a href="https://wip.is" target="_blank" rel="noopener">WIP</a> makes Gui.</span>
      <a href={github} target="_blank" rel="noopener">GitHub</a>
      <a href="/docs">Docs</a>
      <a href="/changelog">Changelog</a>
      <a href="/brand">Brand assets</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
  </footer>

  <Demo slot="after" />
</Base>

<script>
  // Signs up without leaving the page. Without this script, the form posts to /waitlist and the
  // worker sends the browser back to #waitlist-joined.
  const dialog = document.querySelector<HTMLDialogElement>('#waitlist-dialog')!
  const form = dialog.querySelector<HTMLFormElement>('[data-waitlist]')!
  const done = dialog.querySelector<HTMLElement>('[data-waitlist-done]')!
  const status = dialog.querySelector<HTMLElement>('[data-waitlist-status]')!

  const macDialog = document.querySelector<HTMLDialogElement>('#mac-dialog')!

  const dialogs = [macDialog, dialog]
  const historyClosures = new WeakSet<HTMLDialogElement>()
  const showDialog = (target: HTMLDialogElement) => {
    if (target.open) return
    for (const other of dialogs) {
      if (other.open) {
        historyClosures.add(other)
        other.close()
      }
    }
    target.showModal()
    const state = { ...history.state, guiDialog: target.id }
    if (history.state?.guiDialog) history.replaceState(state, '', `#${target.id}`)
    else history.pushState(state, '', `#${target.id}`)
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[commandfor]')) {
    button.addEventListener('click', (event) => {
      event.preventDefault()
      const target = document.getElementById(button.getAttribute('commandfor')!) as HTMLDialogElement
      if (button.getAttribute('command') === 'show-modal') showDialog(target)
      else target.close()
    })
  }
  for (const target of dialogs) {
    target.addEventListener('close', () => {
      if (historyClosures.delete(target)) return
      if (history.state?.guiDialog === target.id) history.back()
    })
    target.addEventListener('click', (event) => {
      if (event.detail > 1) return
      const box = target.getBoundingClientRect()
      const inside = event.clientX >= box.left && event.clientX <= box.right &&
        event.clientY >= box.top && event.clientY <= box.bottom
      if (event.target === target && !inside) target.close()
    })
  }
  addEventListener('popstate', () => {
    for (const target of dialogs) {
      if (history.state?.guiDialog === target.id) {
        if (!target.open) target.showModal()
      } else if (target.open) {
        historyClosures.add(target)
        target.close()
      }
    }
  })

  // Gui is a Mac app: on a phone or tablet, the download button explains that instead of
  // downloading a DMG. iPadOS says it is a Mac, but a Mac has no touch screen.
  const ua = navigator.userAgent
  const notMac = /iPhone|iPad|iPod|Android/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
  if (notMac) {
    document.querySelector('.download-button')!.addEventListener('click', (event) => {
      event.preventDefault()
      showDialog(macDialog)
    })
  }
  document.querySelector('.download-button')!.addEventListener('click', () => {
    if (!notMac) document.querySelector<HTMLElement>('[data-download-help]')!.hidden = false
  })
  // The share sheet sends the link to the Mac (AirDrop, Messages, Mail). Without it, copy the link.
  const share = macDialog.querySelector<HTMLButtonElement>('[data-share]')!
  if (!navigator.share) share.textContent = 'Copy the link'
  share.addEventListener('click', async () => {
    const url = 'https://usegui.com/'
    if (navigator.share) {
      await navigator.share({ title: 'Gui', text: 'Gui for Mac', url }).catch(() => {})
    } else {
      try {
        await navigator.clipboard.writeText(url)
        share.textContent = 'Link copied'
      } catch {
        share.textContent = 'Open usegui.com on your Mac'
      }
    }
  })
  let submission = 0
  let pending: AbortController | null = null
  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (pending) return
    const id = ++submission
    pending = new AbortController()
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    button.disabled = true
    button.textContent = 'Saving…'
    status.dataset.state = 'saving'
    status.textContent = 'Saving your address…'
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { accept: 'application/json' },
      signal: pending.signal,
    }).catch(() => null)
    const result = (await response?.json().catch(() => null)) as { ok?: boolean; error?: string } | null
    if (id !== submission) return
    pending = null
    button.disabled = false
    button.textContent = 'Sign up'
    if (response?.ok && result?.ok) {
      form.hidden = true
      done.hidden = false
      done.querySelector('button')!.focus()
    } else {
      status.dataset.state = 'error'
      status.textContent = result?.error ?? 'Gui could not save your address. Try again.'
    }
  })

  // The next time the dialog opens, it starts with an empty form.
  dialog.addEventListener('close', () => {
    if (dialog.open) return
    submission++
    pending?.abort()
    pending = null
    status.textContent = ''
    delete status.dataset.state
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    button.disabled = false
    button.textContent = 'Sign up'
    if (form.hidden) {
      form.reset()
      form.hidden = false
      done.hidden = true
    }
  })
</script>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .mark {
    display: block;
  }
  .intro-static { display: none; }
  :global(html.seen-intro) .intro-animated { display: none; }
  :global(html.seen-intro) .intro-static { display: block; }
  :global(html.seen-intro) .wordmark { animation: none; }
  :global(html.mark-loading) .wordmark { animation-play-state: paused; }
  .wordmark {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
    animation: wordmark-reveal 350ms ease-out 725ms both;
  }
  .pill {
    margin-left: auto;
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--rule);
