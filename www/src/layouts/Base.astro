---
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url'

interface Props {
  title: string
  description: string
  /** Path of the page, for its canonical URL; leave it out for a page search engines skip */
  path?: string
  /** JSON-LD for the page */
  structuredData?: object
}

const { title, description, path, structuredData } = Astro.props
const site = 'https://usegui.com'
// Only the Latin subset of Inter Tight: anything outside it (the pronunciation's IPA) is set in
// the system font, so no second font file loads. `optional`: the font is preloaded and small, so
// it is nearly always there for the first paint; when it isn't, the page keeps the fallback
// for that visit rather than swapping mid-read (and the next visit has it from the cache).
const fontFace = `@font-face {
  font-family: 'Inter Tight Variable';
  font-style: normal;
  font-display: optional;
  font-weight: 100 900;
  src: url(${interTight}) format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
/* Fallbacks resized to Inter Tight's metrics at weight 300, so nothing moves if the font comes
   in late. Measured from the font files: average English letter width and vertical metrics.
   Helvetica Neue Light (Macs) matches the thin weight; Arial (no light weight) elsewhere. */
@font-face {
  font-family: 'Inter Tight Fallback Light';
  src: local('HelveticaNeue-Light'), local('Helvetica Neue Light');
  font-weight: 100 500;
  size-adjust: 101.54%;
  ascent-override: 95.41%;
  descent-override: 23.76%;
  line-gap-override: 0%;
}
@font-face {
  font-family: 'Inter Tight Fallback';
  src: local('Arial'), local('ArialMT'), local('Liberation Sans'), local('LiberationSans');
  size-adjust: 98.72%;
  ascent-override: 98.13%;
  descent-override: 24.43%;
  line-gap-override: 0%;
}`
const url = path === undefined ? undefined : `${site}${path}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {url ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      url && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Gui" />
          <meta property="og:url" content={url} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={`${site}/og.jpg`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Gui shows a website and a chat with an AI agent." />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={`${site}/og.jpg`} />
        </>
      )
    }
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <!-- The page in a box of its own, so the demo (Demo.astro) can shrink it into a Gui window. -->
    <div class="page" data-page>
      <main>
        <slot />
      </main>
    </div>
    <slot name="after" />
  </body>
</html>

<style is:global>
  :root {
    /* Spacing scale: every margin, padding and gap on the site is one of these. */
    --s-1: 0.25rem;
    --s-2: 0.5rem;
    --s-3: 1rem;
    --s-4: 1.5rem;
    --s-5: 3rem;
    --s-6: 6rem;
    --bg: #fafafa;
    --fg: #111;
    --muted: #6b6b6b;
    --rule: rgba(0, 0, 0, 0.1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161616;
      --fg: #f2f2f2;
      --muted: #9a9a9a;
      --rule: rgba(255, 255, 255, 0.12);
    }
    /* Light text on dark reads heavier without it; dark text on light gets too thin with it. */
    body {
      -webkit-font-smoothing: antialiased;
    }
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  html {
    color-scheme: light dark;
  }
  body {
    background: var(--bg);
    color: var(--fg);
    font-family: 'Inter Tight Variable', 'Inter Tight Fallback Light', 'Inter Tight Fallback', ui-sans-serif, -apple-system, 'Helvetica Neue', sans-serif;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.45;
    text-rendering: optimizeLegibility;
  }
  @media (max-width: 30rem) {
    body {
      font-size: 1.0625rem;
    }
  }
  .page {
    padding: var(--s-6) var(--s-4);
    background: var(--bg);
  }
  main {
    width: 100%;
    max-width: 68rem;
    margin: 0 auto;
  }
  main > :not(.wide) {
    max-width: 40rem;
  }
  h1,
  h2,
  h3 {
    font-size: inherit;
    font-weight: inherit;
  }
  p,
  li,
  dd {
    text-wrap: pretty;
  }
  a {
    color: inherit;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }
  a:hover {
    text-decoration-color: currentColor;
  }
  abbr {
    text-decoration: none;
  }
</style>
