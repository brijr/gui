---
import '@fontsource-variable/inter-tight'
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url'

interface Props {
  title: string
  description: string
  /** Path of the page, for its canonical URL; leave it out for a page search engines skip */
  path?: string
  /** JSON-LD for the page */
  structuredData?: object
}

const { title, description, path, structuredData } = Astro.props
const site = 'https://usegui.com'
const url = path === undefined ? undefined : `${site}${path}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {url ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      url && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Gui" />
          <meta property="og:url" content={url} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={`${site}/og.jpg`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Gui shows a website and a chat with an AI agent." />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={`${site}/og.jpg`} />
        </>
      )
    }
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --fg: #111;
    --muted: #6b6b6b;
    --rule: rgba(0, 0, 0, 0.1);
    --shot-shadow: rgba(0, 0, 0, 0.1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161616;
      --fg: #f2f2f2;
      --muted: #9a9a9a;
      --rule: rgba(255, 255, 255, 0.12);
      --shot-shadow: rgba(0, 0, 0, 0.55);
    }
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  html {
    color-scheme: light dark;
  }
  body {
    padding: 6rem 1.5rem 8rem;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Inter Tight Variable', ui-sans-serif, -apple-system, 'Helvetica Neue', sans-serif;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.38;
    letter-spacing: -0.012em;
    font-feature-settings: 'ss01', 'cv11';
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  main {
    width: 100%;
    max-width: 68rem;
    margin: 0 auto;
  }
  main > :not(.wide) {
    max-width: 40rem;
  }
  h1,
  h2,
  h3 {
    font-size: inherit;
    font-weight: inherit;
  }
  p,
  li,
  dd {
    text-wrap: pretty;
  }
  a {
    color: inherit;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }
  a:hover {
    text-decoration-color: currentColor;
  }
  abbr {
    text-decoration: none;
  }
</style>
