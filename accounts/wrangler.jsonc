{
  "name": "gui-accounts",
  "account_id": "4976e8a5df6887f41b287a83e6b5c18f",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // accounts.usegui.com is where WorkOS and GitHub send the browser back. Installed Gui
  // versions use the workers.dev address, so it stays on.
  "routes": [{ "pattern": "accounts.usegui.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "5204419", "simple": { "limit": 10, "period": 60 } }
  ],
  // WorkOS AuthKit signs people in: its client ID goes here, its API key (WORKOS_API_KEY) is a
  // Worker secret. Until both are set, signing in says it isn't available yet.
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23liakas1b7Im4gK8a",
    "GITHUB_APP_SLUG": "gui-projects",
    // Mints Gui's per-repository push tokens, with the app's key (GITHUB_APP_PRIVATE_KEY, a secret).
    "GITHUB_APP_ID": "5204419",
    // WorkOS Production. Staging's ID and key are in .env as WORKOS_STAGING_*.
    "WORKOS_CLIENT_ID": "client_01M4E6ZJ9EWEMRBJKNBH7HKQH1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gui-accounts",
      "database_id": "50ad7c84-d173-460a-a0cc-516b8db52937",
      "migrations_dir": "migrations"
    }
  ]
}
